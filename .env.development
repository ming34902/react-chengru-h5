# ============ 开发环境 ============
VITE_ENV=development
# 开发服务器端口
VITE_PORT=5173
# 是否使用本地 mock-api（true：请求交给 src/mock 处理，路径与 docs/apifox.json 完全一致；
# false：走 VITE_GLOB_API_URL 指向的真实接口或 Apifox 云 mock）
# 接入 Apifox 云 mock：本项置为 false，并把 VITE_GLOB_API_URL 改成 Apifox 的 mock 地址
VITE_USE_MOCK=true
# 接口地址（使用 dev 代理时留空即可，走 VITE_GLOB_API_URL_PREFIX + VITE_PROXY）
# 例：Apifox 云 mock 地址 https://mock.apifox.com/m1/xxxxx-0-default
VITE_GLOB_API_URL=
# 开发代理：[[前缀, 目标地址], ...]（Vite 会按前缀转发，解决跨域）
VITE_PROXY=[["/api","http://localhost:3000/api"]]
