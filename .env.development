# ============ 开发环境 ============
VITE_ENV=development
# 开发服务器端口
VITE_PORT=5173
# 是否使用本地 mock 数据源（true：使用 src/hooks/useWeda/mockDataSource.ts；false：走 src/api 真实接口）
VITE_USE_MOCK=true
# 接口地址（使用 dev 代理时留空即可，走 VITE_GLOB_API_URL_PREFIX + VITE_PROXY）
VITE_GLOB_API_URL=
# 开发代理：[[前缀, 目标地址], ...]（Vite 会按前缀转发，解决跨域）
VITE_PROXY=[["/api","http://localhost:3000/api"]]
