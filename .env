# ============ 公共环境变量（所有模式共享）============
# 应用标题（页面 title 兜底）
VITE_GLOB_APP_TITLE=商城 Demo
# 部署基础路径
VITE_PUBLIC_PATH=/
# 构建产物目录
VITE_OUTPUT_DIR=dist
# 是否使用 hash 路由
VITE_HASH_ROUTE=false
# 接口前缀（与 VITE_GLOB_API_URL 拼接：API_URL + API_URL_PREFIX + path）
VITE_GLOB_API_URL_PREFIX=/api
# 静态资源（图片）前缀
VITE_GLOB_IMG_URL_PREFIX=
# 上传接口地址
VITE_GLOB_UPLOAD_URL=/upload
# 构建压缩方式：gzip | brotli | none
VITE_BUILD_COMPRESS=none
# 压缩后是否删除源文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE=false
