# ============ 环境变量示例（可提交到仓库）============
# 复制为 .env.development / .env.test / .env.production 后按需修改
VITE_ENV=development
VITE_PORT=5173
# 是否使用本地 mock（true：不依赖后端即可运行；false：走 src/api 真实接口）
VITE_USE_MOCK=true
# 接口地址（留空则使用同域 + VITE_GLOB_API_URL_PREFIX，并由 VITE_PROXY 在开发时转发）
VITE_GLOB_API_URL=
VITE_GLOB_API_URL_PREFIX=/api
# 开发代理配置：[[匹配前缀, 目标地址]]
VITE_PROXY=[["/api","http://localhost:3000/api"]]
